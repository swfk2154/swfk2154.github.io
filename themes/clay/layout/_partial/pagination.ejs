<% if (page.total && page.total > 1) { %>
<nav class="pagination" aria-label="分页">
  <% if (page.prev) { %>
    <a class="pagination__item" href="<%- url_for(page.prev_link) %>">← 上一页</a>
  <% } else { %>
    <span class="pagination__item is-disabled">← 上一页</span>
  <% } %>
  <span class="pagination__info"><%= page.current %> / <%= page.total %></span>
  <% if (page.next) { %>
    <a class="pagination__item" href="<%- url_for(page.next_link) %>">下一页 →</a>
  <% } else { %>
    <span class="pagination__item is-disabled">下一页 →</span>
  <% } %>
</nav>
<% } %>
