<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__id">
      <img class="site-footer__avatar" src="<%- url_for(theme.avatar || '/images/clay-avatar.svg') %>" alt="<%= config.author %>" loading="lazy">
      <div class="site-footer__id-text">
        <strong><%= config.title %></strong>
        <span><%= config.subtitle || config.description %></span>
      </div>
    </div>
    <div class="site-footer__links">
      <% if (theme.social && theme.social.github) { %>
        <a href="<%= theme.social.github %>" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.26 5.66.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          GitHub
        </a>
      <% } %>
      <% if (theme.social && theme.social.email) { %>
        <a href="mailto:<%= theme.social.email %>">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          邮件
        </a>
      <% } %>
      <% if (theme.social && theme.social.rss) { %>
        <a href="<%- url_for('/atom.xml') %>">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.4"/></svg>
          RSS
        </a>
      <% } %>
    </div>
  </div>
  <div class="site-footer__bar">
    <span>© <%- theme.footer && theme.footer.since ? theme.footer.since + ' - ' : '' %><%= new Date().getFullYear() %> <%= config.author %></span>
    <span>由 <a href="https://hexo.io/" target="_blank" rel="noopener noreferrer">Hexo</a> 驱动 · Clay 主题</span>
    <% if (theme.footer && theme.footer.icp && theme.footer.icp.enable && theme.footer.icp.text) { %>
      <a href="<%= theme.footer.icp.url || '#' %>" target="_blank" rel="noopener noreferrer"><%= theme.footer.icp.text %></a>
    <% } %>
    <% if (theme.footer && theme.footer.busuanzi) { %>
      <span id="busuanzi_container_site_uv" style="display:none">访客 <span id="busuanzi_value_site_uv"></span></span>
      <span id="busuanzi_container_site_pv" style="display:none">浏览 <span id="busuanzi_value_site_pv"></span></span>
    <% } %>
  </div>
</footer>
