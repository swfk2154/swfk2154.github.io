<% if (theme.music && theme.music.enable) { %>
<%
var sources = [];
if (theme.music.sources && theme.music.sources.length) {
  sources = theme.music.sources.filter(function (s) { return s && s.id; });
}
var defaultApis = ['https://api.injahow.cn/meting/?server=:server&type=:type&id=:id'];
var apis = theme.music.apis && theme.music.apis.length ? theme.music.apis :
  (theme.music.api ? [theme.music.api].concat(defaultApis.slice(1)) : defaultApis);
var order = theme.music.order || 'list';
var maxh = theme.music.maxHeight || '320px';
var autoplay = theme.music.autoplay ? 'true' : 'false';
var panelTitle = sources.length === 1 ? (sources[0].name || '音乐') : '音乐';
%>
<div class="music-player" data-music-player>
  <!-- 移动端暗色遮罩层 -->
  <div class="music-player__backdrop" data-music-backdrop aria-hidden="true"></div>

  <!-- 切歌微气泡提示 -->
  <aside class="music-player__toast" data-music-toast aria-live="polite">
    <span class="music-player__toast-note">🎵</span>
    <div class="music-player__toast-info">
      <span class="music-player__toast-title" data-toast-title>未知曲目</span>
      <span class="music-player__toast-artist" data-toast-artist>未知歌手</span>
    </div>
  </aside>

  <button type="button" class="music-player__toggle" data-music-toggle aria-expanded="false" aria-controls="music-player-panel" aria-label="打开音乐播放器" title="音乐">
    <span class="music-player__disc" aria-hidden="true">
      <img class="music-player__disc-cover" data-music-cover alt="" hidden referrerpolicy="no-referrer">
      <svg class="music-player__disc-note" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
    </span>
    <span class="music-player__pulse" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  </button>

  <section class="music-player__panel" id="music-player-panel" data-music-panel aria-hidden="true">
    <div class="music-player__ambient" data-music-ambient aria-hidden="true"></div>
    <div class="music-player__mobile-handle" aria-hidden="true"></div>
    <div class="music-player__panel-head">
      <div class="music-player__head-copy">
        <span class="music-player__eyebrow">MUSIC PLAYING</span>
        <h2><%= panelTitle %></h2>
      </div>
      <button type="button" class="music-player__close" data-music-close aria-label="收起">&#215;</button>
    </div>
    <% if (sources.length > 1) { %>
    <div class="music-player__tabs" role="tablist">
      <% sources.forEach(function (s, i) { %>
        <button type="button" role="tab" class="music-player__tab <%= i === 0 ? 'is-active' : '' %>" data-music-tab="<%= i %>"><%= s.name || s.server %></button>
      <% }); %>
    </div>
    <% } %>
    <div class="music-player__box">
      <% sources.forEach(function (s, i) { %>
      <div class="music-player__pane <%= i === 0 ? 'is-active' : '' %>" data-music-pane="<%= i %>">
        <div class="music-player__mount" data-ap-mount="<%= i %>"></div>
      </div>
      <% }); %>
      <% if (!sources.length) { %>
      <p class="music-player__empty">尚未配置音乐源：请在主题 <code>_config.yml</code> 的 <code>music.sources</code> 中填写歌单 ID。</p>
      <% } %>
    </div>
    <p class="music-player__foot">来自网易云音乐 · 点击列表选曲</p>
  </section>
  <script>window.__CLAY_MUSIC__ = <%- JSON.stringify({ apis: apis, sources: sources.map(function (s) { return { server: s.server, type: s.type || 'playlist', id: s.id }; }), order: order, listMaxHeight: maxh, autoplay: autoplay === 'true' }); %>;</script>
</div>
<% } %>
