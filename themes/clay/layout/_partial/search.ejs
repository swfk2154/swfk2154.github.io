<%# 站内搜索弹层：由 js/search.js 驱动，索引来自 /search.json %>
<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search-bar">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
      <input type="text" class="search-input" id="search-input" placeholder="搜索文章：标题 / 标签 / 正文…"
             autocomplete="off" autocapitalize="off" spellcheck="false">
      <button type="button" class="search-esc" data-search-close aria-label="关闭搜索">Esc</button>
    </div>
    <ul class="search-results" id="search-results"></ul>
    <div class="search-hint">↑ ↓ 选择 · Enter 打开 · Esc 关闭</div>
  </div>
</div>
