<%
var allPosts = site.posts.sort('-date').toArray();
var stickyPosts = allPosts.filter(function(p) { return p.top || p.sticky; });
var picks = [];
stickyPosts.forEach(function(p) { picks.push(p); });
allPosts.forEach(function(p) {
  if (picks.length >= (theme.featured && theme.featured.count || 5)) return;
  if (stickyPosts.indexOf(p) === -1) picks.push(p);
});

function hueOf(title) {
  var h = 0;
  for (var i = 0; i < title.length; i++) h = (h * 31 + title.charCodeAt(i)) % 360;
  return 12 + (h % 32);
}
function pickDesc(p) {
  var d = p.summary || (p.excerpt ? strip_html(p.excerpt) : '') || strip_html(p.content || '');
  if (d.length > 80) d = d.slice(0, 80) + '…';
  return d;
}
function pickCat(p) {
  return (p.categories && p.categories.length) ? p.categories.first().name : '';
}
function coverOf(p) {
  var v = p.coverImg || p.img || p.cover;
  return (typeof v === 'string' && v) ? v : '';
}
%>
<section class="hero">
  <div class="hero-scene" aria-hidden="true">
    <span class="float-orb float-orb--a" data-depth="26"></span>
    <span class="float-orb float-orb--b" data-depth="-38"></span>
    <span class="float-orb float-orb--c" data-depth="14"></span>
  </div>
  <div class="hero__intro">
    <img class="hero__avatar" src="<%- url_for(theme.avatar || '/images/clay-avatar.svg') %>" alt="<%= config.author %>" width="80" height="80">
    <p class="eyebrow"><%= theme.eyebrow || '' %></p>
    <h1 class="hero__title"><%= theme.greeting || config.title %></h1>
    <p class="hero__bio"><%= theme.bio || config.description %></p>
    <div class="hero__actions">
      <a class="text-link" href="<%- url_for('/archives') %>">
        浏览文章
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <span class="hero__social" aria-label="社交链接">
        <% if (theme.social && theme.social.github) { %>
          <a class="icon-button" href="<%= theme.social.github %>" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.75 2.7 1.25 3.36.95.1-.74.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.26 5.66.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"/></svg>
          </a>
        <% } %>
        <% if (theme.social && theme.social.rss) { %>
          <a class="icon-button" href="<%- url_for('/atom.xml') %>" aria-label="RSS 订阅">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.4"/></svg>
          </a>
        <% } %>
      </span>
    </div>
  </div>

  <% if (picks.length) { %>
  <aside class="hero__picks" aria-label="精选文章">
    <p class="hero__picks-label">精选</p>
    <div class="picks">
      <a class="pick-hero" href="<%- url_for(picks[0].path) %>">
        <span class="pick-hero__thumb<%= coverOf(picks[0]) ? '' : ' pick__thumb--fallback' %>"<% if (!coverOf(picks[0])) { %> style="--h:<%= hueOf(picks[0].title) %>"<% } %>>
          <% if (coverOf(picks[0])) { %><img src="<%- url_for(coverOf(picks[0])) %>" alt="" loading="eager" onerror="this.parentElement.classList.add('pick__thumb--fallback');this.remove()"><% } %>
          <span class="pick-hero__shade" aria-hidden="true"></span>
          <span class="pick-hero__overlay">
            <span class="post-meta">
              <% if (pickCat(picks[0])) { %><span><%= pickCat(picks[0]) %></span><% } %>
              <time datetime="<%= date(picks[0].date, 'YYYY-MM-DD') %>"><%= date(picks[0].date, 'YYYY-MM-DD') %></time>
            </span>
            <span class="pick-hero__title"><%= picks[0].title %></span>
          </span>
        </span>
        <span class="pick-hero__desc"><%= pickDesc(picks[0]) %></span>
      </a>

      <% if (picks.length > 1) { %>
      <ul class="pick-side">
        <% picks.slice(1, 5).forEach(function(p) { %>
        <li>
          <a class="pick-side__item" href="<%- url_for(p.path) %>">
            <% if (coverOf(p)) { %>
              <span class="pick-side__thumb"><img src="<%- url_for(coverOf(p)) %>" alt="" loading="lazy" onerror="this.parentElement.classList.add('pick__thumb--fallback');this.remove()"></span>
            <% } else { %>
              <span class="pick-side__thumb pick__thumb--fallback" style="--h:<%= hueOf(p.title) %>"></span>
            <% } %>
            <span class="pick-side__text">
              <span class="pick-side__title"><%= p.title %></span>
              <time class="pick-side__date" datetime="<%= date(p.date, 'YYYY-MM-DD') %>"><%= date(p.date, 'YYYY-MM-DD') %></time>
            </span>
          </a>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </aside>
  <% } %>
</section>

<section class="section">
  <div class="section__header section__header--row">
    <div>
      <h2>最新文章</h2>
      <p>持续更新 AI 安全、网络安全与工程实践笔记。</p>
    </div>
    <a class="section__more" href="<%- url_for('/archives') %>">
      全部 <%= site.posts.length %> 篇
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  </div>
  <div class="post-list" aria-label="文章列表">
    <% page.posts.forEach(function(post) { %>
      <%- partial('_partial/post-row', { post: post }) %>
    <% }); %>
  </div>
  <%- partial('_partial/pagination') %>
</section>
